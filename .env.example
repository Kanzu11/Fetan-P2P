# Fetan P2P Environment Variables Example (NEVER commit real secrets in .env)

# Cryptographic Session Signing (Generate 64+ hex characters: openssl rand -hex 32)
JWT_SECRET="replace_with_random_64_char_jwt_secret_key"

# Real-Time Email Delivery (Gmail App Password or SMTP)
EMAIL_SERVICE="gmail"
EMAIL_USER="notifications@example.com"
EMAIL_PASS="xxxx xxxx xxxx xxxx"
ADMIN_EMAIL="admin@example.com"
SUPERADMIN_EMAIL="superadmin@example.com"

# Google Sign-In OAuth (OIDC Web Client ID)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Telegram Bot & Mini App Integration
ADMIN_TELEGRAM_USERNAME="your_admin_username"
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_BOT_USERNAME="your_bot_username"
TELEGRAM_WEBHOOK_SECRET="replace_with_random_webhook_secret_token"
TELEGRAM_SYNC_SECRET="replace_with_random_sync_secret_token"
TGCLOUD_TOKEN="your_tgcloud_token_here"
TELEGRAM_MINIAPP_URL="https://t.me/your_bot_username/app"

# Shared PostgreSQL Connection (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/fetan_p2p?sslmode=require"

# Public App & Pricing Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="your_bot_username"
NEXT_PUBLIC_TELEGRAM_MINIAPP_URL="https://t.me/your_bot_username/app"
REFERENCE_ETB_PER_USDT="158.45"
NEXT_PUBLIC_REFERENCE_ETB_PER_USDT="158.45"

# Crypto Deposit Hot/Cold Derivation (Binance / OKX model)
# Account level xpub: m/44'/60'/0' (Never store private keys on server!)
DEPOSIT_XPUB="xpub6CQ8...your_master_public_key_here"
# TON platform hot wallet address (All users deposit here with a unique Memo)
DEPOSIT_TON_ADDRESS="EQ...your_ton_hot_wallet_address"

# Blockchain RPC & Explorer Verification APIs
BSC_RPC_URL="https://bsc-dataseed.binance.org"
BSC_MIN_CONFIRMATIONS="6"
TRONGRID_API_KEY="your_trongrid_api_key"
TONCENTER_API_KEY="your_toncenter_api_key"
