// Fetan P2P PostgreSQL Prisma Schema (Shared by Website & Telegram Serverless)
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  MERCHANT
  ADMIN
  SUPERADMIN
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum MerchantStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_SENT
  COMPLETED
  DISPUTED
  CANCELLED
}

enum WalletTxType {
  DEPOSIT
  WITHDRAW
}

enum WalletTxStatus {
  COMPLETED
  PENDING
  REJECTED
}

model User {
  id                    String                @id @default(uuid())
  email                 String                @unique
  name                  String
  nickname              String?
  passwordHash          String?
  authProvider          String                @default("email")
  emailVerified         Boolean               @default(false)
  phone                 String?
  telegramHandle        String?
  telegramChatId        String?               @unique
  telegramNotifications Boolean               @default(true)
  telegramLinkCode      String?               @unique
  role                  Role                  @default(USER)
  kycStatus             KycStatus             @default(UNVERIFIED)
  kycDocType            String?               // 'NATIONAL_ID' | 'PASSPORT' | 'DRIVERS_LICENSE'
  kycDocNumber          String?
  kycSubmittedAt        DateTime?
  merchantStatus        MerchantStatus        @default(NONE)
  usdtBalance           Decimal               @default(0.0) @db.Decimal(18, 6)
  usdtLocked            Decimal               @default(0.0) @db.Decimal(18, 6)
  paymentDetails        Json?
  depositAddresses      Json?
  completedTrades       Int                   @default(0)
  completionRate        Float                 @default(100)
  avgReleaseTimeMins    Int                   @default(2)
  rating                Float                 @default(5)
  positiveFeedback      Int                   @default(0)
  negativeFeedback      Int                   @default(0)
  lastLoginAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  offers                P2POffer[]
  ordersAsBuyer         P2POrder[]            @relation("BuyerOrders")
  ordersAsSeller        P2POrder[]            @relation("SellerOrders")
  supportTickets        SupportTicket[]
  kycSubmissions        KycSubmission[]
  merchantApplications  MerchantApplication[]
  walletTransactions    WalletTransaction[]
  uploadedFiles         UploadedFile[]
}

model OtpChallenge {
  id         String    @id @default(uuid())
  email      String
  purpose    String    // 'LOGIN' | 'WITHDRAW'
  codeHash   String
  attempts   Int       @default(0)
  maxAttempts Int      @default(5)
  metadata   Json?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

model P2POffer {
  id                 String     @id
  merchantId         String
  merchant           User       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  merchantName       String
  completedTrades    Int        @default(0)
  completionRate     Float      @default(100)
  merchantRating     Float      @default(5)
  avgReleaseTimeMins Int        @default(2)
  offerType          String     // 'SELL' | 'BUY'
  pricePerUsdtEtb    Decimal    @db.Decimal(10, 2)
  minLimitEtb        Decimal    @db.Decimal(12, 2)
  maxLimitEtb        Decimal    @db.Decimal(12, 2)
  totalAvailable     Decimal    @db.Decimal(18, 6)
  paymentMethods     String[]
  terms              String?
  isActive           Boolean    @default(true)
  isOnline           Boolean    @default(true)
  isVerifiedMerchant Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  orders             P2POrder[]

  @@index([offerType, isActive])
  @@index([merchantId])
}

model P2POrder {
  id              String        @id
  offerId         String
  offer           P2POffer      @relation(fields: [offerId], references: [id])
  offerType       String        @default("SELL")
  buyerId         String
  buyerName       String
  sellerId        String
  sellerName      String
  buyer           User          @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller          User          @relation("SellerOrders", fields: [sellerId], references: [id])
  usdtAmount      Decimal       @db.Decimal(18, 6)
  etbAmount       Decimal       @db.Decimal(12, 2)
  unitPriceEtb    Decimal       @db.Decimal(10, 2)
  paymentMethod   String
  paymentDetails  Json
  status          OrderStatus   @default(PENDING_PAYMENT)
  proofReceiptUrl String?
  expiresAt       DateTime
  paidAt          DateTime?
  autoReleaseAt   DateTime?
  isAutoRelease   Boolean       @default(false)
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelledBy     String?
  cancelReason    String?
  disputeReason   String?
  appealedBy      String?
  appealedAt      DateTime?
  resolvedBy      String?
  resolutionNote  String?
  buyerFeedback   Json?
  sellerFeedback  Json?
  auditLogs       Json          @default("[]")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  chatMessages    ChatMessage[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([offerId, status])
  @@index([status, createdAt])
}

model ChatMessage {
  id         String   @id
  orderId    String
  order      P2POrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  senderId   String
  senderName String
  senderRole String
  text       String
  imageUrl   String?
  type       String   @default("TEXT")
  isSystem   Boolean  @default(false)
  timestamp  DateTime @default(now())

  @@index([orderId, timestamp])
}

model KycSubmission {
  id             String    @id
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEmail      String
  userName       String
  telegramHandle String?
  source         String    @default("WEB")
  kycDocType     String
  kycDocNumber   String
  docPhotoUrl    String?
  status         KycStatus @default(PENDING)
  submittedAt    DateTime  @default(now())
  reviewedBy     String?
  reviewedAt     DateTime?

  @@index([status, submittedAt])
  @@index([userId])
}

model MerchantApplication {
  id               String    @id
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userEmail        String
  userName         String
  businessName     String?
  telegramHandle   String
  kycDocType       String
  kycDocNumber     String
  proofDocumentUrl String?
  usdtBalance      Decimal   @db.Decimal(18, 6)
  tradeExperience  String?
  terms            String?
  status           String    @default("PENDING") // 'PENDING' | 'APPROVED' | 'REJECTED'
  submittedAt      DateTime  @default(now())
  reviewedBy       String?
  reviewedAt       DateTime?

  @@index([status, submittedAt])
  @@index([userId])
}

model WalletTransaction {
  id         String         @id
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       WalletTxType
  amount     Decimal        @db.Decimal(18, 6)
  network    String         // 'TRC20' | 'BEP20' | 'TON'
  txHash     String?        @unique
  address    String?
  status     WalletTxStatus @default(PENDING)
  note       String?
  reviewedBy String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([userId, createdAt])
  @@index([status, type])
}

model UploadedFile {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folder      String   // 'kyc' | 'receipts' | 'general'
  filename    String
  mimeType    String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())

  @@index([ownerId])
  @@index([folder])
}

model SupportTicket {
  id             String   @id
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName       String
  userEmail      String
  telegramHandle String?
  orderId        String?
  category       String   // 'ORDER_COMPLAINT' | 'PAYMENT_ISSUE' | 'KYC_HELP' | 'GENERAL_SUPPORT'
  subject        String
  message        String
  status         String   @default("OPEN")
  adminReply     String?
  resolvedBy     String?
  source         String   @default("WEB")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorRole  String?
  action     String
  targetType String?
  targetId   String?
  ip         String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

model RateLimitRecord {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}
