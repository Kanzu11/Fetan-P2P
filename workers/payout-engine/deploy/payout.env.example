# Oracle Cloud Always Free (ARM64) isolated payout worker configuration
# Save on the Oracle VM at /etc/fetan/payout.env with permissions:
#   sudo chown root:fetan-payout /etc/fetan/payout.env && sudo chmod 640 /etc/fetan/payout.env
# NEVER store HOT_WALLET_PRIVATE_KEY in this or any env file!

PAYOUT_WORKER_ID="oracle-arm-1"

# Chain configuration: use 97 (BSC Testnet) first, then switch to 56 (BSC Mainnet)
PAYOUT_CHAIN_ID="97"
# BSC Mainnet USDT: 0x55d398326f99059ff775485246999027b3197955
# BSC Testnet USDT: set your test BEP-20 contract address when PAYOUT_CHAIN_ID=97
USDT_BEP20_CONTRACT="0x55d398326f99059ff775485246999027b3197955"

# Pinned public address of the dedicated hot wallet (NEVER reuse DEPOSIT_XPUB seed!)
HOT_WALLET_ADDRESS="0xYourDedicatedHotWalletPublicAddress"

# Secret loading source: 'oci-vault' (Instance Principal) or 'credential' (systemd LoadCredential 0600 file)
HOT_WALLET_KEY_SOURCE="credential"
# Required only when HOT_WALLET_KEY_SOURCE="oci-vault":
# OCI_REGION="eu-frankfurt-1"
# OCI_VAULT_SECRET_OCID="ocid1.vaultsecret.oc1..."

# Minimum 3 independent BSC RPC endpoints (comma-separated)
BSC_RPC_URLS="https://bsc-dataseed.binance.org,https://bsc-dataseed1.defibit.io,https://bsc-rpc.publicnode.com,https://bsc.drpc.org"

# Drain protection & gas ceilings
PAYOUT_MIN_BNB="0.02"
PAYOUT_MIN_USDT="200"
PAYOUT_MAX_GWEI="10"
PAYOUT_RECEIPT_TIMEOUT_MS="180000"
PAYOUT_POLL_INTERVAL_MS="5000"
PAYOUT_RECONCILE_INTERVAL_MS="3600000"

# Dedicated low-privilege PostgreSQL connection (use non-pooler direct URL when available)
DATABASE_URL="postgresql://fetan_worker:strong_password@your-neon-direct-host:5432/neondb?sslmode=require"

# Admin alerts via Telegram Bot API
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_ADMIN_CHAT_ID="your_admin_chat_id_here"
